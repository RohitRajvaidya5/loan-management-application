APP_NAME=Loan Management API
APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://loan_user:replace-password@localhost:5432/loan_management
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
DOCUMENT_STORAGE_PATH=var/documents
MAX_DOCUMENT_SIZE_BYTES=10485760
CORS_ORIGINS=[]
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10
# Email remains completely disabled until explicitly configured.
NOTIFICATIONS_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=15
# Set SMTP_USERNAME and SMTP_PASSWORD together if authentication is required.
EMAIL_FROM=no-reply@example.com
EMAIL_SENDER_NAME=Loan Management
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_SECONDS=60
NOTIFICATION_LEASE_SECONDS=300